# The kernel image carries source and builds its own gates. Anything compiled
# on the host is a different platform's artifact and must never leak in: the
# whole point of ADR-0025's second build platform is that the image builds the
# gates itself and proves them with conformance.
kernel/bin/
out/

.git/
.github/
node_modules/
**/__pycache__/
**/*.pyc
.venv/
venv/

# Not part of the kernel image.
docs/
packages/
prior-art/a24-v1/agents/
prior-art/a24-v1/bridge/
prior-art/a24-v1/doctrine/
prior-art/a24-v1/kernel/
*.md
