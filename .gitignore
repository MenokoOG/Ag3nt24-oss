# Node
node_modules/
dist/

# Compiled COBOL gates are build output. BUILD-MANIFEST.json is committed:
# it records which source hashes produced which binary hashes under which cobc.
kernel/bin/*.exe
kernel/bin/*.bin
!kernel/bin/BUILD-MANIFEST.json

# Conformance fixtures are regenerated from the kernel on every run
out/

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Secrets never travel
.env
.env.*
!.env.example

# OS
Thumbs.db
.DS_Store

# Working files. Not needed to read, build or run anything here.
# Session prompts, agent scratch and local assistant config stay on the
# machine that made them (ADR-0022: private working files do not travel).
Claude outputs/
docs/plan/*next-session*.md
.claude/
.github/instructions/
agent-memory/
